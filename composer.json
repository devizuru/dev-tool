{
    "name": "dreamon/dev-tool",
    "description": "Dev tool commands for Dreamon CMS",
    "type": "package",
    "license": "MIT",
    "keywords": [
        "dreamon",
        "dreamon cms",
        "dreamon platform",
        "dreamon dev tools"
    ],
    "homepage": "https://dreamon.com",
    "authors": [
        {
            "name": "Dreamon Technologies",
            "email": "contact@dreamon.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Dreamon\\DevTool\\": "src"
        }
    },
    "require": {
        "laravel/framework": "^10.31|^11.0|^12.0"
    },
    "require-dev": {
        "laravel/pint": "^1.5.0",
        "phpunit/phpunit": "^9.0|^10.0|^11.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dreamon\\DevTool\\Providers\\DevToolServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
